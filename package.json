{
  "name": "breezy-cuts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:next": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run cf:typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "wrangler deploy",
    "worker:deploy": "wrangler deploy",
    "production:test": "npm --prefix production-worker test",
    "production:dry-run": "npm --prefix production-worker run dry-run",
    "production:deploy": "npm --prefix production-worker run deploy:production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mobile:sync": "cap sync",
    "android:apk": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.5.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0",
    "wrangler": "^4.111.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
